{
    "name": "cosmos",
    "version": "G2-F33-P3",
    "description": "A modern, enterprise-grade WhatsApp Bot framework",
    "repository": {
        "type": "git",
        "url": "git@github.com:razaelmahasaputra/cosmos.git"
    },
    "main": "src/index.ts",
    "type": "module",
    "imports": {
        "#*": "./dist/*"
    },
    "scripts": {
        "dev": "tsx src/index.ts",
        "pair": "tsx src/cli/pair.ts",
        "tgpair": "tsx src/cli/tgpair.ts",
        "start": "node dist/index.js",
        "start:bg": "./start.sh",
        "stop:bg": "./stop.sh",
        "status:bg": "./status.sh",
        "pm2:start": "pm2 start ecosystem.config.cjs",
        "pm2:stop": "pm2 stop ecosystem.config.cjs",
        "pm2:restart": "pm2 restart ecosystem.config.cjs",
        "pm2:logs": "pm2 logs",
        "build": "tsc && tsx scripts/i18n/copy-locales.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "validate:i18n": "tsx scripts/i18n/validate.ts && tsx scripts/i18n/check-usage.ts",
        "mcp:start": "tsx src/mcp/index.ts",
        "mcp:http": "tsx src/mcp/index.ts --transport=http",
        "release:pre": "tsx scripts/release/release.ts",
        "version:show": "tsx scripts/release/version.ts show",
        "version:check": "tsx scripts/release/version.ts check",
        "version:verify": "tsx scripts/release/version.ts verify",
        "version:bump": "tsx scripts/release/version.ts bump",
        "docker:build": "./scripts/docker/build.sh",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:logs": "docker logs cosmos-origin --tail 100",
        "docker:status": "docker inspect cosmos-origin --format 'running: {{.Image}}' 2>/dev/null || echo 'Container is not running.'",
        "docker:deploy": "./scripts/docker/deploy.sh",
        "docker:dev": "./scripts/docker/dev.sh",
        "docker:dev:build": "./scripts/docker/dev.sh build",
        "docker:dev:up": "./scripts/docker/dev.sh up",
        "docker:dev:down": "./scripts/docker/dev.sh down",
        "docker:dev:restart": "./scripts/docker/dev.sh restart",
        "docker:dev:logs": "./scripts/docker/dev.sh logs",
        "docker:dev:clean": "./scripts/docker/dev.sh clean",
        "docker:prune": "docker image prune -f && docker builder prune -f --reserved-space 2GB",
        "tunnel:setup": "./scripts/infra/setup-cloudflare-tunnel.sh",
        "turnstile:create": "./scripts/infra/create-turnstile-widget.sh",
        "doppler:setup": "./scripts/infra/sync-doppler.sh setup",
        "doppler:pull:prd": "./scripts/infra/sync-doppler.sh pull prd",
        "doppler:pull:dev": "./scripts/infra/sync-doppler.sh pull dev",
        "doppler:push:prd": "./scripts/infra/sync-doppler.sh push prd",
        "doppler:push:dev": "./scripts/infra/sync-doppler.sh push dev",
        "doppler:status": "./scripts/infra/sync-doppler.sh status"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.31.0",
        "@tavily/core": "^0.7.13",
        "@prisma/adapter-better-sqlite3": "^7.9.0",
        "@prisma/client": "^7.9.0",
        "@whiskeysockets/baileys": "7.0.0-rc14",
        "axios": "^1.18.1",
        "better-sqlite3": "^12.11.1",
        "chance": "^1.1.13",
        "dotenv": "^17.4.2",
        "fflate": "^0.8.3",
        "form-data": "^4.0.6",
        "groq-sdk": "^1.3.0",
        "i18next": "^26.4.2",
        "jsonrepair": "^3.15.0",
        "node-cron": "^4.6.0",
        "opentype.js": "^2.0.0",
        "pino": "^10.3.1",
        "qrcode": "^1.5.4",
        "qrcode-terminal": "^0.12.0",
        "sharp": "^0.35.3",
        "telegram": "^2.26.22",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/chance": "^1.1.8",
        "@types/form-data": "^2.5.2",
        "@types/node": "^22.13.4",
        "@types/node-cron": "^3.0.11",
        "@types/opentype.js": "^1.3.10",
        "@types/qrcode": "^1.5.6",
        "@types/qrcode-terminal": "^0.12.2",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "prettier": "^3.9.4",
        "prisma": "^7.9.0",
        "tsx": "^4.19.3",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.24.1"
    },
    "optionalDependencies": {
        "ffmpeg-static": "^5.2.0"
    }
}
