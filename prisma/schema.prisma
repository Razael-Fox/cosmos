// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model WhatsAppAuth {
  id         String   @id
  value      String
  updated_at DateTime @default(now()) @updatedAt
}

enum Language {
  ID
  EN
}

model WhitelistedGroup {
  jid       String   @id
  language  Language @default(ID)
  ownerJid  String?
  owner     User?    @relation(fields: [ownerJid], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([ownerJid])
}

enum SubscriptionTier {
  FREE
  SUBSIDIZED
  PARTNER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  GRACE_PERIOD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier         SubscriptionTier   @default(FREE)
  status       SubscriptionStatus @default(ACTIVE)
  maxSubBots   Int                @default(2)
  maxGroups    Int                @default(5)
  customPrefix Boolean            @default(false)
  startedAt    DateTime           @default(now())
  expiresAt    DateTime?
  updatedAt    DateTime           @updatedAt

  payments PaymentTransaction[]
}

model PaymentTransaction {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier           SubscriptionTier
  amount         BigInt
  status         PaymentStatus    @default(PAID)
  paymentMethod  String           @default("MANUAL_WHATSAPP")
  confirmedBy    String?
  orderRef       String?          @unique
  notes          String?
  paidAt         DateTime?        @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

model OtpVerification {
  id           String   @id @default(cuid())
  phoneNumber  String
  userJid      String?
  user         User?    @relation(fields: [userJid], references: [id], onDelete: Cascade)
  codeHash     String
  salt         String
  lookupHash   String?
  metadata     String?
  regSessionId String?  @unique
  purpose      String   @default("REGISTRATION")
  attempts     Int      @default(0)
  maxAttempts  Int      @default(3)
  expiresAt    DateTime
  isUsed       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([phoneNumber, purpose, isUsed])
  @@index([regSessionId])
  @@index([lookupHash])
}

model WebSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserDevice {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceTokenHash String
  lastIpAddress   String
  userAgent       String
  deviceType      String?
  browser         String?
  os              String?
  country         String?
  city            String?
  isTrusted       Boolean  @default(false)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now()) @updatedAt
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, deviceTokenHash])
  @@index([userId, isTrusted])
  @@index([lastIpAddress])
}

model UserIpAccessLog {
  id        String  @id @default(cuid())
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  country   String?
  userAgent String?
  action    String
  status    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@index([action, status])
}

model SubBotInstance {
  id           String   @id
  ownerJid     String
  owner        User     @relation(fields: [ownerJid], references: [id], onDelete: Cascade)
  customPrefix String   @default(".")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerJid])
}

model TelegramPrivateChat {
  chatId     String   @id
  title      String?
  inviteLink String?
  added_at   DateTime @default(now()) @updatedAt
}

model ActiveSession {
  feature    String
  jid        String
  metadata   String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@id([feature, jid])
}

model AiChatSession {
  jid        String          @id
  summary    String          @default("")
  updated_at DateTime        @default(now()) @updatedAt
  messages   AiChatMessage[]
}

model AiChatMessage {
  id        Int           @id @default(autoincrement())
  jid       String
  session   AiChatSession @relation(fields: [jid], references: [jid], onDelete: Cascade)
  role      String
  content   String
  timestamp DateTime      @default(now())
}

model AutoDlSetting {
  jid        String
  platform   String
  enabled    Boolean  @default(true)
  updated_at DateTime @default(now()) @updatedAt

  @@id([jid, platform])
}

model ScheduledDeletion {
  id         Int      @id @default(autoincrement())
  jid        String
  msgId      String
  fromMe     Boolean
  deleteAt   DateTime
  created_at DateTime @default(now())

  @@unique([jid, msgId])
}

model User {
  id             String    @id // Nomor WA / JID (contoh: 628123456789@s.whatsapp.net)
  lid            String?   @unique // Local Identifier (LID)
  pushName       String? // Display Name / Nama Profil WhatsApp
  username       String?   @unique // Username baru WhatsApp (contoh: razael123)
  email          String?   @unique
  passwordHash   String?
  isWhitelisted  Boolean   @default(false)
  lastLoginIp    String?
  lastLoginAt    DateTime?
  language       Language  @default(ID)
  balance        BigInt    @default(10000) // Starterpack 10,000 Rp
  lastDailyClaim DateTime?
  lastGambleAt   DateTime? // Cooldown permanen per user untuk minigame
  gamesPlayed    Int       @default(0)
  totalWins      Int       @default(0)
  totalLosses    Int       @default(0)
  // Roulette Minigame-specific statistics (new)
  rouletteRounds Int       @default(0)
  rouletteWins   Int       @default(0)
  rouletteKills  Int       @default(0)
  rouletteAfk    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditScore          Int                   @default(500) // Default starting credit score
  currentJobId         Int?
  currentJob           JobCatalog?           @relation(fields: [currentJobId], references: [id], onDelete: SetNull)
  lastWorkedAt         DateTime?
  inventories          UserInventory[]
  propertyTransactions PropertyTransaction[]
  idCard               IdCard?
  bankAccount          BankAccount?
  loans                Loan[]
  activities           ActivityLog[]
  subscription         Subscription?
  payments             PaymentTransaction[]
  webSessions          WebSession[]
  otpRecords           OtpVerification[]
  whitelistedGroups    WhitelistedGroup[]
  subBots              SubBotInstance[]
  devices              UserDevice[]
  ipAccessLogs         UserIpAccessLog[]
}

model JobCatalog {
  id              Int     @id @default(autoincrement())
  name            String  @unique // e.g., 'Mining', 'Office Work'
  description     String
  baseSalary      BigInt  // Base payout before economy multiplier
  cooldownMinutes Int     @default(60)
  requiredItemId  String? // Links to an Item.id or shortId (e.g., Pickaxe, MacBook)
  isActive        Boolean @default(true)

  workers         User[]
}

model HouseVault {
  id        Int      @id @default(1)
  income    BigInt   @default(0) // Total koin masuk (kalah dari player)
  payout    BigInt   @default(0) // Total koin keluar (diberikan ke player)
  netProfit BigInt   @default(0) // Keuntungan bersih bandar
  updatedAt DateTime @updatedAt
}

model ExchangeRateLog {
  id        Int      @id @default(autoincrement())
  rate      Float
  source    String
  createdAt DateTime @default(now())
}

model EconomyMultiplier {
  id         Int      @id @default(autoincrement())
  multiplier Float
  reasoning  String?
  appliedAt  DateTime @default(now())
}

model PropertyCatalog {
  id                   String                @id @default(uuid())
  name                 String
  typeCategory         String
  basePrice            BigInt
  baseDepreciationRate Float
  inventories          UserInventory[]
  transactions         PropertyTransaction[]
}

model Item {
  id          String          @id @default(uuid())
  shortId     String          @unique
  name        String
  description String
  price       BigInt
  type        String
  isAvailable Boolean         @default(true)
  inventories UserInventory[]
}

model UserInventory {
  id              String           @id @default(uuid())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  item            Item?            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId          String?
  quantity        Int              @default(1)
  property        PropertyCatalog? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyId      String?
  name            String?
  typeCategory    String?
  originalPrice   BigInt?
  ownershipStatus String           @default("Owned") // 'Owned', 'Pawned', 'Sold'
  purchaseDate    DateTime         @default(now())

  @@unique([userId, itemId])
}

model PropertyTransaction {
  id               String          @id @default(uuid())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  property         PropertyCatalog @relation(fields: [propertyId], references: [id])
  propertyId       String
  transactionType  String // 'Buy', 'Sell', 'Pawn'
  amount           BigInt
  timestamp        DateTime        @default(now())
  aiNegotiationLog String?
}

model IdCard {
  nik           String   @id // 16-digit Nomor Induk Kependudukan
  userJid       String   @unique
  fullName      String
  placeOfBirth  String
  dateOfBirth   String
  gender        String
  bloodType     String   @default("O")
  address       String
  rtRw          String   @default("001/002")
  village       String   @default("Sukajadi")
  district      String   @default("Sukajadi")
  city          String   @default("BANDUNG")
  provinsi      String   @default("JAWA BARAT")
  religion      String
  maritalStatus String
  occupation    String
  citizenship   String   @default("WNI")
  validUntil    String   @default("SEUMUR HIDUP")
  issuedAt      DateTime @default(now())

  // Relation to the main User model
  user User @relation(fields: [userJid], references: [id], onDelete: Cascade)
}

model BankAccount {
  accountNumber String   @id // Unique generated account number (e.g., 10-digit)
  userJid       String   @unique
  balance       BigInt   @default(0) // Bank balance (separate from User.balance)
  status        String   @default("ACTIVE") // ACTIVE, FROZEN, SUSPENDED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User              @relation(fields: [userJid], references: [id], onDelete: Cascade)
  transactions BankTransaction[]
}

model BankTransaction {
  id             String   @id @default(uuid())
  accountNumber  String
  type           String // DEPOSIT, WITHDRAWAL, TRANSFER_IN, TRANSFER_OUT, FEE, INTEREST
  amount         BigInt
  description    String?
  relatedAccount String? // If transfer, the counterparty account number
  timestamp      DateTime @default(now())

  account BankAccount @relation(fields: [accountNumber], references: [accountNumber], onDelete: Cascade)
}

model Loan {
  id              String   @id @default(uuid())
  userId          String
  principalAmount BigInt   // The original borrowed amount
  interestRate    Float    // Interest rate determined by AI (e.g., 0.05 for 5%)
  dueDate         DateTime // Repayment deadline determined by AI
  status          String   @default("ACTIVE") // "ACTIVE", "PAID", "DEFAULTED"
  collateralItems String?  // JSON string representing pledged assets
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders LoanReminder[]

  @@index([userId])
  @@index([status])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "LOAN_REPAYMENT", "LOAN_DEFAULT", "CASINO_LOSS", "CASINO_WIN", "REAL_ESTATE_PURCHASE", "DEPOSIT", "WITHDRAWAL", etc.
  amount      BigInt?  // Relevant amount for the activity
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model LoanReminder {
  id        String   @id @default(uuid())
  loanId    String
  userJid   String
  chatJid   String?
  remindAt  DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([remindAt, sent])
}

model GroupNsfwSetting {
  jid       String   @id
  enabled   Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt

  @@index([enabled])
}

