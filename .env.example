# =========================================================
# WAF (WhatsApp Bot Framework) - Environment Configuration
# =========================================================

# --- Database Config ---
# Prisma local SQLite database connection
DATABASE_URL="file:./storage/database.sqlite"

# --- Telegram Auto-Backup ---
# Required for sending automated SQLite backups to Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# --- Telegram Private Content Proxy ---
# Required for downloading media from private groups via a paired dummy account.
# Obtain api_id and api_hash at https://my.telegram.org (API development tools),
# then pair the dummy account once with "pnpm tgpair".
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# --- Bot Configuration ---
# Bot device number used only as a fallback for non-interactive pairing runtimes.
# When starting interactively, the bot number is requested via a startup prompt.
BOT_PHONE_NUMBER="628123456789"
# Privileged owner numbers (comma-separated for multiple owners).
# Commands gated by owner privileges succeed only from these numbers (or the bot device itself via fromMe).
OWNER_PHONE_NUMBER="628123456789"
# Pairing method for non-interactive runtimes: code | qr (default: code).
PAIRING_METHOD="code"
GROQ_API_KEY="gsk_your_groq_api_key"
GROQ_MODEL="llama3-8b-8192"
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key"
EODHD_API_KEY="your_eodhd_api_key"

# --- Cloudflare Tunnel & NAT VPS Domain Config ---
# Cloudflare Tunnel token for cosmos.razael-fox.my.id (leave empty if using direct NAT VPS ingress)
CLOUDFLARE_TUNNEL_TOKEN=""
APP_DOMAIN="38.49.212.111:1623"
NEXT_PUBLIC_SITE_URL="http://38.49.212.111:1623"
NEXT_PUBLIC_API_URL="http://38.49.212.111:1623"

# --- LXC NAT VPS Port Forwarding Reference ---
# Private IP: 192.168.11.86 | Public IP: 38.49.212.111
# 38.49.212.111:1040  -> 192.168.11.86:22     (SSH)
# 38.49.212.111:1377  -> 192.168.11.86:3000   (Dev Web Portal)
# 38.49.212.111:1434  -> 192.168.11.86:4000   (Dev API Gateway)
# 38.49.212.111:1992  -> 192.168.11.86:5000
# 38.49.212.111:1570  -> 192.168.11.86:5432   (PostgreSQL)
# 38.49.212.111:1166  -> 192.168.11.86:6379   (Redis)
# 38.49.212.111:1282  -> 192.168.11.86:8000
# 38.49.212.111:1623  -> 192.168.11.86:8080   (Production All-in-One Nginx)
# 38.49.212.111:1385  -> 192.168.11.86:8800
# 38.49.212.111:1998  -> 192.168.11.86:8888
# 38.49.212.111:1536  -> 192.168.11.86:3030

# --- Security Secrets ---
JWT_SECRET="your_secure_jwt_secret_min_32_characters"
OTP_SECRET="your_secure_otp_secret_min_32_characters"
INTERNAL_IPC_SECRET="your_secure_internal_ipc_secret"
STORAGE_ENCRYPTION_KEY="your_secure_storage_encryption_key"
ADMIN_API_KEY="your_admin_api_key"
# Cloudflare Turnstile keys (Create in Cloudflare Dashboard -> Turnstile -> Add Widget)
# If empty, the app defaults to official Cloudflare test keys (Testing Mode - Always Passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."
CLOUDFLARE_TURNSTILE_SECRET_KEY="0x4AAAAAA..."


