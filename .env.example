# =========================================================
# WAF (WhatsApp Bot Framework) - Environment Configuration
# =========================================================

# --- Database Config ---
# Prisma local SQLite database connection
DATABASE_URL="file:./storage/database.sqlite"

# --- Telegram Auto-Backup ---
# Required for sending automated SQLite backups to Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# --- Telegram Private Content Proxy ---
# Required for downloading media from private groups via a paired dummy account.
# Obtain api_id and api_hash at https://my.telegram.org (API development tools),
# then pair the dummy account once with "pnpm tgpair".
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# --- Bot Configuration ---
# Bot device number used only as a fallback for non-interactive pairing runtimes.
# When starting interactively, the bot number is requested via a startup prompt.
BOT_PHONE_NUMBER="628123456789"
# Privileged owner numbers (comma-separated for multiple owners).
# Commands gated by owner privileges succeed only from these numbers (or the bot device itself via fromMe).
OWNER_PHONE_NUMBER="628123456789"
# Pairing method for non-interactive runtimes: code | qr (default: code).
PAIRING_METHOD="code"
GROQ_API_KEY="gsk_your_groq_api_key"
GROQ_MODEL="openai/gpt-oss-20b"
AGENT_EXECUTOR_MODEL="openai/gpt-oss-20b"
AGENT_GUIDANCE_MODEL="openai/gpt-oss-20b"
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key"
EODHD_API_KEY="your_eodhd_api_key"
# Rule34 API Authentication (Required for authenticated API queries and higher rate limits)
RULE34_API_KEY="your_rule34_api_key"
RULE34_USER_ID="your_rule34_user_id"
# Tavily Search API (Required for the Sara AI web_search tool; leave empty to disable search gracefully)
TAVILY_API_KEY="tvly-your_tavily_api_key"

# --- Cloudflare Tunnel & Domain Config ---
# Cloudflare Tunnel token (leave empty if using direct host/reverse-proxy ingress)
CLOUDFLARE_TUNNEL_TOKEN=""
APP_DOMAIN="cosmos.example.com"
NEXT_PUBLIC_SITE_URL="https://cosmos.example.com"
NEXT_PUBLIC_API_URL="https://cosmos.example.com"

# --- Host Port Mapping (Optional for NAT VPS) ---
# Override host ports if deploying behind NAT VPS or port forwarding:
# HOST_PORT_ALL_IN_ONE=8080
# HOST_PORT_API=4000
# HOST_PORT_WEB=3000

# --- Security Secrets ---
JWT_SECRET="your_secure_jwt_secret_min_32_characters"
OTP_SECRET="your_secure_otp_secret_min_32_characters"
INTERNAL_IPC_SECRET="your_secure_internal_ipc_secret"
STORAGE_ENCRYPTION_KEY="your_secure_storage_encryption_key"
ADMIN_API_KEY="your_admin_api_key"

# --- Cosmos MCP Server (Developer AI Agent Surface) ---
# SINGLE-OWNER API KEY. Exactly one key authenticates the entire MCP toolset and
# it is held personally by the repository owner. There is no per-agent key, no
# per-workspace key, no self-service rotation, and no backdoor. Only the owner can
# rotate it: regenerate the value here (or in Doppler), redeploy, and reconfigure
# every client. OpenCode, Claude Code, Pi, and Antigravity all reference this same
# key. The server FAILS CLOSED: if this value is empty the MCP server refuses to
# start and every HTTP request is refused with 401 UNAUTHORIZED_MCP.
# NEVER commit the real value; never bake it into a Docker build ARG.
COSMOS_MCP_TOKEN=""
# Bind address for the Streamable HTTP transport. Loopback only (Rule V); a
# non-loopback value makes the server refuse to start.
COSMOS_MCP_HTTP_BIND="127.0.0.1"
COSMOS_MCP_HTTP_PORT="4100"
COSMOS_MCP_HTTP_ENABLED="true"
# Set true to compile the entire mutating toolset out of the server.
COSMOS_MCP_READ_ONLY="false"
# JID the MCP audit trail attaches ActivityLog rows to. Falls back to the first
# configured OWNER_PHONE_NUMBER when empty.
COSMOS_MCP_AUDIT_USER_JID=""
# Optional guardrail tuning.
COSMOS_MCP_DEFAULT_QUERY_LIMIT="200"
COSMOS_MCP_MAX_QUERY_LIMIT="1000"
COSMOS_MCP_MAX_BULK_DELETE_ROWS="50"
COSMOS_MCP_MAX_BROADCAST_TARGETS="5000"
COSMOS_MCP_MIN_BROADCAST_DELAY_MS="1000"
COSMOS_MCP_MAX_BROADCAST_DELAY_MS="3600000"
COSMOS_MCP_MAX_MESSAGE_LENGTH="4096"
COSMOS_MCP_MAX_CALLS="600"
COSMOS_MCP_MAX_MUTATIONS="60"
COSMOS_MCP_MAX_CONCURRENT_MUTATIONS="2"
COSMOS_MCP_RATE_WINDOW_MS="60000"
# Cloudflare Turnstile keys (Create in Cloudflare Dashboard -> Turnstile -> Add Widget)
# If empty, the app defaults to official Cloudflare test keys (Testing Mode - Always Passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."
CLOUDFLARE_TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# --- External Status Notifications (Optional) ---
# Unified outbound status channel for logger, health, backup, and audit data.
# Fail-closed: an empty URL disables only its own channel; local logs always work.
STATUS_NOTIFY_ENABLED="true"
# Minimum severity dispatched to external channels: INFO | WARN | CRITICAL (default: WARN)
STATUS_NOTIFY_MIN_SEVERITY="WARN"
# Discord webhook (Channel Settings -> Integrations -> Webhooks)
DISCORD_STATUS_WEBHOOK_URL=""
DISCORD_STATUS_ENABLED="true"
# Slack incoming webhook (Slack App -> Incoming Webhooks)
SLACK_STATUS_WEBHOOK_URL=""
SLACK_STATUS_ENABLED="true"
# WhatsApp Channel / Newsletter JID (e.g. 1234567890@newsletter)
WA_STATUS_NEWSLETTER_JID=""
WA_STATUS_ENABLED="true"
# Owner JID used as a direct-message fallback when the channel send fails
WA_STATUS_OWNER_JID=""
WA_STATUS_FALLBACK_DM="true"
# Raw database artifact uploads (Discord/WhatsApp file attachments).
# DANGER: defaults to OFF. The SQLite snapshot contains Baileys session
# credentials, bank ledgers, and user data — enabling this exfiltrates the full
# database to broad channel audiences. Enable only for a trusted recovery
# channel. Hash/metadata-only alerts are always sent regardless.
STATUS_NOTIFY_BACKUP_ARTIFACTS_ENABLED="false"
# Worker cron expressions and request tuning (optional)
STATUS_NOTIFY_OUTBOX_CRON="*/2 * * * *"
STATUS_NOTIFY_DIGEST_CRON="0 23 * * *"
STATUS_NOTIFY_TIMEOUT_MS="10000"
STATUS_NOTIFY_MAX_ATTEMPTS="3"



