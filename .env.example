# Cosmos Web Portal Environment Configuration

# Fastify API Gateway URL (leave empty for same-origin / development fallback)
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Primary Cosmos Bot WhatsApp Number (without '+' or leading zero, e.g. 628123456789)
NEXT_PUBLIC_BOT_NUMBER=628123456789

# Cosmos Sales Representative WhatsApp Number for manual sales flow
NEXT_PUBLIC_SALES_NUMBER=628123456789

# Cloudflare Turnstile Site Key
# 1x00000000000000000000AA is the official Cloudflare test site key that always passes
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Public URL of the web portal
NEXT_PUBLIC_SITE_URL=http://localhost:3000
